trait CylinderShape:
    .doc: """
    Adds the legacy generated cylinder contact geometry for a linear
    actuator part. Use this explicitly when a synthetic cylinder shape is
    desired in addition to the connectors from RigidCylinderPart.
    """

    cylinder is Physics3D.Geometries.Cylinder:
        height: length
        radius: diameter * 0.5
        local_transform:
            rotation: Math.Quat.from_to(Math.Vec3.Y_AXIS(), Math.Vec3.Z_AXIS())
            position: Math.Vec3.from_xyz(0, 0, length * 0.5)
