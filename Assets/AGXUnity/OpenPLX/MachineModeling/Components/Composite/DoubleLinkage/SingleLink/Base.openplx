Base is MachineModeling.Components.Composite.DoubleLinkage.Base:
    .doc: """
    Double-linkage variant using one drive link and one guide link.
    """

    drive_link is MachineModeling.Components.Primitive.Link.Base
    guide_link is MachineModeling.Components.Primitive.Link.Base

    drive_connector_1: drive_link.connector_1
    drive_connector_2: drive_link.connector_2

    guide_connector_1: guide_link.connector_1
    guide_connector_2: guide_link.connector_2

    guide_link_connection becomes MachineModeling.Connections.Pivot.Hinge
    drive_connection becomes MachineModeling.Connections.Pivot.Hinge
    link_connection becomes MachineModeling.Connections.Pivot.Hinge
