Base is Bulldozer.Rigid.Base:
    blade_connection becomes Bulldozer.Connections.Blade.PushBars.Base:
        chassis: chassis
        blade: blade
        left_push_bar: left_push_bar
        right_push_bar: right_push_bar

    left_push_bar_connection is MachineModeling.Connections.Pivot.Hinge:
        hinge.initial_angle: 0
        from: chassis.left_pushbar_connector
        to: left_push_bar.rear_connector
    right_push_bar_connection is MachineModeling.Connections.Pivot.Hinge:
        hinge.initial_angle: 0
        from: chassis.right_pushbar_connector
        to: right_push_bar.rear_connector

    left_push_bar is MachineModeling.Components.Primitive.Base with Vehicles.Bulldozer.Interfaces.PushBars.BaseConnectors
    right_push_bar is MachineModeling.Components.Primitive.Base with Vehicles.Bulldozer.Interfaces.PushBars.BaseConnectors

    undercarriage_connection:
        chassis: chassis
        right_bogie: undercarriage.right_bogie
        left_bogie: undercarriage.left_bogie
