trait RearSuspension:
    rear_left_suspension becomes Vehicles.Suspensions.SingleMate.LinearSpringDamper:
        mate becomes Vehicles.Suspensions.SingleMate.Interactions.LinearSpringDamper
        attachment_connector: rear_left_wheel.connector
        chassis_connector: chassis.rear_left_connector
    chassis.rear_left_connector is Physics3D.Interactions.MateConnector

    rear_right_suspension becomes Vehicles.Suspensions.SingleMate.LinearSpringDamper:
        mate becomes Vehicles.Suspensions.SingleMate.Interactions.LinearSpringDamper
        attachment_connector: rear_right_wheel.connector
        chassis_connector: chassis.rear_right_connector
    chassis.rear_right_connector is Physics3D.Interactions.MateConnector
